# Optional Node/SQLite server only. GitHub Pages uses pages/config.js instead.
# Configure these in the server host; local use needs none.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
DB_PATH=/var/data/family.sqlite
# Render supplies RENDER_EXTERNAL_URL automatically.
# For another host or a custom domain, set the exact HTTPS origin:
# APP_ORIGIN=https://your-app.example.com
